# Veilpay — copy to .env.local
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Pollar (testnet) — pub_* is client-safe; sec_* is server-only, never NEXT_PUBLIC_
NEXT_PUBLIC_POLLAR_KEY=
POLLAR_SECRET_KEY=

# NEAR Intents 1Click (mainnet stealth path)
NEAR_INTENTS_API_URL=https://1click.chaindefuser.com
NEAR_INTENTS_JWT=

# Optional: deployed confidential / solvency contracts on Stellar testnet
NEXT_PUBLIC_CONFIDENTIAL_TOKEN_ID=
NEXT_PUBLIC_SOLVENCY_GUARD_ID=
