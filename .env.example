# Veilpay — copy to .env.local
NEXT_PUBLIC_NETWORK=testnet
# Stellar RPC only (Horizon is EOL — do not set HORIZON URLs)
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Pollar (testnet) — pub_* is client-safe; sec_* is server-only, never NEXT_PUBLIC_
NEXT_PUBLIC_POLLAR_KEY=
POLLAR_SECRET_KEY=

# Aurora Intents (mainnet confidential stealth path) — server only
AURORA_INTENTS_API_URL=https://intents-api.aurora.dev
AURORA_INTENTS_API_KEY=

# Stellar Private Payments (Nethermind) — event archive when RPC retention is too short.
# Official demo default (override to self-host): https://bootnode.dev-nethermind.xyz
NEXT_PUBLIC_SPP_BOOTNODE_URL=https://bootnode.dev-nethermind.xyz
# Legacy alias still accepted by the client:
# NEAR_INTENTS_JWT=

# OZ confidential token (v0.8) with SolvencyHooks — Stellar testnet
NEXT_PUBLIC_CONFIDENTIAL_TOKEN_ID=CBUOT3ETCV4R6AVGXBVNIWHWE64AWOH3GV53AEUGCTPBS73YIM7LFNE7
NEXT_PUBLIC_CONFIDENTIAL_VERIFIER_ID=CCTW4FGYDGE7EEIFAPRNPMZPZXZWU6A7FT5ZFUTNT2LUYKTBI6A6WVC4
NEXT_PUBLIC_CONFIDENTIAL_AUDITOR_ID=CASPCMOFIJCPSYLXR5CUOPMM5RKBUDK6UB5LH6RBCYLTFSHDDBCCI4MF
# Deprecated alias (same as token — solvency lives on the token Hooks)
NEXT_PUBLIC_SOLVENCY_GUARD_ID=

# VNS durable registry (manageData via Stellar RPC — no Horizon)
NEXT_PUBLIC_VNS_REGISTRY_ADDRESS=GCWCP6UXP7XCZYZML5XEF26FL7HUCRONBO6PTPELKERARB2DS4D6VFEC
# Server-only secret for the registry account (testnet) — required to persist names across cold starts
VNS_REGISTRY_SECRET=
